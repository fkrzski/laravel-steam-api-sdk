includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    level: max
    tmpDir: .cache/phpstan
    paths:
        - src
        - tests

    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # Command::secret() returns ?string, and InstallCommand::askForKey()
        # has a branch for the null. PendingCommand::expectsQuestion() rejects
        # null, so the test covering that branch cannot be written without
        # tripping this. Laravel's annotation is narrower than its own runtime
        # contract, and the union it lists widens between releases, so the
        # pattern matches on the null argument rather than on the union.
        -
            identifier: argument.type
            message: '#expectsQuestion\(\) expects .+, null given#'
            path: tests/Feature/InstallCommandTest.php
            count: 1
